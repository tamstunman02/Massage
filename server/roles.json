{
  "admin": {
    "label": "ผู้ดูแล",
    "permissions": [
      "user:view", "user:suspend", "user:delete",
      "provider:view", "provider:approve", "provider:suspend",
      "service:view", "service:edit", "service:delete",
      "booking:view:all", "booking:cancel:all",
      "membership:manage",
      "report:view", "dashboard:admin"
    ]
  },
  "seller": {
    "label": "ผู้ขายบริการ",
    "permissions": [
      "profile:edit:own",
      "service:create", "service:edit:own", "service:delete:own", "service:view",
      "booking:view:own", "booking:accept", "booking:reject", "booking:complete",
      "review:view:own", "review:reply",
      "income:view:own", "dashboard:seller"
    ]
  },
  "buyer": {
    "label": "ผู้ซื้อบริการ",
    "permissions": [
      "profile:edit:own",
      "provider:view", "service:view",
      "booking:create", "booking:view:own", "booking:cancel:own",
      "favorite:manage",
      "review:create", "payment:create"
    ]
  }
}
